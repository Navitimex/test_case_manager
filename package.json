{
  "name": "testflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend-api",
    "frontend-ui"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace=backend-api\" \"npm run dev --workspace=frontend-ui\"",
    "dev:backend": "npm run dev --workspace=backend-api",
    "dev:frontend": "npm run dev --workspace=frontend-ui",
    "build:backend": "npm run build --workspace=backend-api",
    "build:frontend": "npm run build --workspace=frontend-ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
