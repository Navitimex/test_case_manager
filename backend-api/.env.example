# Database connection (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/testflow"

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET="change-me-to-a-long-random-secret"

# API port (optional, defaults to 4000)
PORT=4000

# Comma-separated allowed CORS origins (optional, defaults to http://localhost:3000)
CORS_ORIGINS="http://localhost:3000"

# Anthropic API key for the AI test case generator
ANTHROPIC_API_KEY=
